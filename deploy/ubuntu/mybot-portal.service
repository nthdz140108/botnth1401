[Unit]
Description=MYBOT Cloud customer portal
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=mybot-portal
Group=mybot-portal
WorkingDirectory=/opt/mybot/current
EnvironmentFile=/etc/mybot/portal.env
ExecStart=/opt/mybot/current/bin/mybot-portal
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mybot-portal
UMask=0077

[Install]
WantedBy=multi-user.target
