# ==============================================================================
# HHH_MYBOT-V3 — Example Environment Configuration
# Copy to .env.local (install.bat creates .env.local automatically on VPS)
# ==============================================================================

# --- Runtime & Resource Profile (Windows Server 2012 R2 Optimized) ---
NODE_SKIP_PLATFORM_CHECK=1
MYBOT_RESOURCE_PROFILE=lean

# --- Web Dashboard (Port 4173) ---
DASHBOARD_PORT=4173
DASHBOARD_HOST=0.0.0.0
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DASHBOARD_COOKIE_SAMESITE=Strict
DASHBOARD_SESSION_TTL_MS=43200000
DASHBOARD_LOGIN_RATE_LIMIT_WINDOW_MS=900000
DASHBOARD_LOGIN_RATE_LIMIT_MAX=5
QR_LOGIN_MAX_CONCURRENT=0

# --- Bot Web Health Port ---
BOT_WEB_HOST=127.0.0.1
BOT_WEB_PORT=3301
ZALO_UPLOAD_CONCURRENCY=4

# --- AI & Search Providers (Optional - configure keys you use) ---
GEMINI_API_KEYS=
GEMINI_MODEL_PRIORITY=gemini-2.5-flash,gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CSE_ID=
SERPAPI_API_KEY=
SIMSIMI_API_KEY=

# --- Media & Utility Providers (Optional) ---
YOUTUBE_API_KEY=
YOUTUBE_COOKIES_FILE=
YOUTUBE_PROXY_URL=
SOUNDCLOUD_CLIENT_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_DOWNLOADER_SECRET=
SPOTIFY_DOWNLOADER_PASSPHRASE=
ZINGMP3_API_KEY=
ZINGMP3_SECRET_KEY=
TIKTOK_COOKIE=
TIKTOK_SEARCH_API_URL=
TIKTOK_SEARCH_API_KEY=
PINTEREST_API_KEY=
CAPCUT_API_KEY=
TENOR_API_KEY=
REMOVE_BG_API_KEY=
IMGUR_CLIENT_ID=
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=
TOMORROW_API_KEY=
HOANGDEV_API_KEY=

# --- Security / Domain Check Providers (Optional) ---
VIRUSTOTAL_API_KEY=
SAFE_BROWSING_API_KEY=
URLVOID_API_KEY=
WHOIS_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_API_KEY=
SHODAN_API_KEY=
